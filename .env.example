# Copy to .env.local for local overrides. All variables are read at build time.

# Public origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# Defaults: https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3000.
SITE_URL=https://www.example.com

# Allow search engines to index the site. Keep "false" until the owner approves launch.
# Building with "true" while SITE_URL is still localhost fails on purpose.
SITE_INDEXABLE=false
